# Copy to .env.local and fill in from the Supabase dashboard:
# Project Settings > API Keys (or the "Connect" dialog > Next.js).
# Both values are public by design (they ship to the browser); security is
# enforced by Row Level Security, not by hiding these.
# Never put real credentials or service-role secrets in this file.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Brevo SMTP credentials go in the Supabase dashboard (Authentication > SMTP),
# NOT here. The app never talks to Brevo directly. See docs/auth_setup.md.
